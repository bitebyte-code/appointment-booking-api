{
  "info": {
    "name": "Appointment Booking API",
    "_postman_id": "c3c1e2b8-5e2a-4a7f-8b40-2c3d92d7b8a1",
    "description": "Postman requests for the Appointment Booking API internship project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "providerToken",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "providerId",
      "value": ""
    },
    {
      "key": "slotId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "2 - Authentication",
      "item": [
        {
          "name": "Register provider",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const d = pm.response.json().data;",
                  "  pm.collectionVariables.set('providerToken', d.token);",
                  "  pm.collectionVariables.set('providerId', d.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Priya Provider\",\n  \"email\": \"provider{{$timestamp}}@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"provider\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Register user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('userToken', pm.response.json().data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"user{{$timestamp}}@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"user\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Current user (requires userToken)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}"
                }
              ]
            },
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "3 - Slots",
      "item": [
        {
          "name": "Create future slot (provider)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const start = new Date(Date.now() + 60 * 60 * 1000);",
                  "const end = new Date(Date.now() + 90 * 60 * 1000);",
                  "pm.variables.set('slotStart', start.toISOString());",
                  "pm.variables.set('slotEnd', end.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('slotId', pm.response.json().data.slot._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{providerToken}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"{{slotStart}}\",\n  \"endTime\": \"{{slotEnd}}\"\n}"
            },
            "url": "{{baseUrl}}/api/slots",
            "description": "Replace startTime/endTime with future ISO-8601 times. End must be later than start."
          }
        },
        {
          "name": "List available slots",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/slots"
          }
        }
      ]
    },
    {
      "name": "4 - Bookings",
      "item": [
        {
          "name": "Book slot (user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('bookingId', pm.response.json().data.booking._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings"
          }
        },
        {
          "name": "My bookings",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}"
                }
              ]
            },
            "url": "{{baseUrl}}/api/bookings/my"
          }
        },
        {
          "name": "Cancel booking",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}"
                }
              ]
            },
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel"
          }
        },
        {
          "name": "Attempt second booking (expect 409)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings"
          }
        }
      ]
    },
    {
      "name": "5 - Validation and role checks",
      "item": [
        {
          "name": "User attempts to create slot (expect 403)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"2030-01-15T10:00:00.000Z\",\n  \"endTime\": \"2030-01-15T10:30:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/api/slots"
          }
        },
        {
          "name": "Invalid registration (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        }
      ]
    }
  ]
}